# URL backend HTTPS tanpa garis miring di akhir.
EXPO_PUBLIC_API_BASE=https://example.com

# Nomor WhatsApp toko dalam format internasional tanpa tanda +.
EXPO_PUBLIC_STORE_WHATSAPP=6280000000000

# Firebase Web API key untuk pertukaran custom token pelanggan.
# Nilai EXPO_PUBLIC_* tertanam di aplikasi; jangan gunakan server key di sini.
EXPO_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_web_api_key
