{
  "name": "morgen-geschaft-mobile",
  "description": "Aplikasi pelanggan Morgen Geschäft untuk Android, dibangun dengan React Native dan Expo.",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings=0",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "npx --yes expo-doctor",
    "build": "expo export --platform android --output-dir dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:sensitive": "node scripts/check-public-repo.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:links && npm run check:sensitive && npm run build"
  },
  "private": true
}
